# Copy to .env and fill in. This one file configures the whole one-server setup (docker-compose.yml reads it).
# Generate secrets with:  openssl rand -base64 36

# ---------- Your addresses ----------
# Two names pointing at this server. The web and API must share the same parent domain so the login cookie works.
WEB_DOMAIN=www.example.com
API_DOMAIN=api.example.com
NEXT_PUBLIC_SITE_URL=https://www.example.com
NEXT_PUBLIC_API_URL=https://api.example.com
WEB_ORIGIN=https://www.example.com
# The parent domain, with a leading dot, so the login cookie is shared by www and api.
COOKIE_DOMAIN=.example.com

# ---------- Database ----------
POSTGRES_USER=shop
POSTGRES_PASSWORD=change-this-long-random-password
POSTGRES_DB=shop
# Using a managed database (RDS, Supabase, Neon, DigitalOcean, Azure...)? Set its address here and remove the `db` service.
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ---------- Security ----------
JWT_SECRET=paste-a-random-string-of-48-or-more-characters
# First admin account, created with:  docker compose run --rm api npm run admin:create
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-long-password-of-12-or-more-characters

# ---------- Email (pick ONE) ----------
MAIL_FROM="Your Shop <orders@example.com>"
# Any SMTP provider (Brevo, Mailgun, Zoho, Gmail app password, Postmark...):
SMTP_URL=smtps://username:password@smtp.example.com:465
# ...or Amazon SES (leave SMTP_URL empty): AWS_REGION=ap-south-1 plus AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY
AWS_REGION=

# ---------- Where uploaded pictures and videos are kept ----------
# local = on this server's disk (a Docker volume, included in backup.sh). s3 = any S3-compatible bucket.
STORAGE_DRIVER=local
# S3_BUCKET=my-shop-media
# S3_REGION=ap-south-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Other providers also need an endpoint, for example:
#   Cloudflare R2:       S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com   S3_REGION=auto
#   DigitalOcean Spaces: S3_ENDPOINT=https://blr1.digitaloceanspaces.com             S3_REGION=blr1
#   Backblaze B2:        S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com          S3_REGION=us-west-004
#   MinIO (own server):  S3_ENDPOINT=http://minio:9000   S3_FORCE_PATH_STYLE=true
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false
# Optional: a public bucket address or CDN in front of it, so browsers fetch originals without signed links.
# STORAGE_PUBLIC_URL=https://media.example.com

# ---------- Online payments (leave empty for cash on delivery only) ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------- Optional sign-in and messaging ----------
GOOGLE_CLIENT_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=order_update
WHATSAPP_TEMPLATE_LANG=en

# ---------- Search and cache ----------
# Leave MEILI_URL empty to use plain database search. To use Meilisearch: docker compose --profile search up -d
MEILI_URL=
MEILI_MASTER_KEY=
# Redis cache. Default is the bundled one; set to empty to run without a cache.
# REDIS_URL=redis://cache:6379

# ---------- Operations ----------
# Number of proxies in front of the API (1 for the bundled Caddy; 2 if a CDN such as Cloudflare is also in front).
TRUST_PROXY=1
# json = one line per log entry (works with any log tool); remove for plain text.
LOG_FORMAT=json
# Optional: a Slack, Discord or any JSON webhook (with a text field) URL that receives a message when the API hits an unexpected error.
ERROR_WEBHOOK_URL=
BACKUP_KEEP_DAYS=14

# ---------- Business details shown on policy and contact pages (can also be set later in Admin) ----------
NEXT_PUBLIC_BUSINESS_NAME=
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_GSTIN=
NEXT_PUBLIC_GRIEVANCE_OFFICER=
NEXT_PUBLIC_GRIEVANCE_EMAIL=
