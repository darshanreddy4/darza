DATABASE_URL="postgresql://dmg:dmg@localhost:5432/dmg?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
WEB_ORIGIN="http://localhost:3000"
# Set when the web app and API are on sibling subdomains, e.g. ".example.com".
COOKIE_DOMAIN=""
PORT=4000
ADMIN_EMAIL="admin@dmg.local"
ADMIN_PASSWORD="change-me-now"

# Online payments (leave empty to offer pay-on-delivery only). Use test keys from the Razorpay dashboard.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Set the same secret on the webhook (event: payment.captured) pointing to <api>/payments/razorpay/webhook
RAZORPAY_WEBHOOK_SECRET=""

# Search (Meilisearch). Leave MEILI_URL empty to fall back to database search.
MEILI_URL="http://localhost:7700"
MEILI_MASTER_KEY="dmg-dev-master-key-0123456789"

# Transactional email (verification, password reset, order updates). Use ONE of:
#  - any SMTP provider (Brevo, Mailgun, Zoho, Postmark, Gmail app password...): SMTP_URL="smtps://user:password@smtp.host:465"
#  - Amazon SES: AWS_REGION plus AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY (or a role on the server)
# Leave all empty in development: emails are printed to the API log instead.
MAIL_FROM=""
SMTP_URL=""
AWS_REGION=""

# Where uploaded pictures and videos are kept: "local" (the uploads folder / a mounted volume) or "s3" (any S3-compatible
# bucket: AWS S3, Cloudflare R2, DigitalOcean Spaces, Backblaze B2, MinIO, Wasabi...).
STORAGE_DRIVER="local"
# UPLOAD_DIR=""            # local only; defaults to ./uploads
# S3_BUCKET=""
# S3_REGION=""             # "auto" for Cloudflare R2
# S3_ENDPOINT=""           # leave empty for AWS S3; set for R2, Spaces, B2, MinIO...
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_FORCE_PATH_STYLE="false"   # "true" for MinIO and some other self-hosted buckets
# S3_PREFIX=""             # optional folder inside the bucket
# STORAGE_PUBLIC_URL=""    # optional public bucket or CDN address, so browsers fetch originals directly

# Cache (Redis) for the home page, banners, categories and product lists.
# Leave REDIS_URL empty to run without a cache.
REDIS_URL="redis://localhost:6379"

# Sign in with Google: create an OAuth "Web application" client at console.cloud.google.com
# and add your site address under "Authorised JavaScript origins". Leave empty to hide the button.
GOOGLE_CLIENT_ID=""

# Sign in with a phone number sends a one-time code by SMS (Twilio). Without these, development logs the code
# in the API console and production hides the phone option.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# Order updates on WhatsApp (Meta WhatsApp Business Cloud API). Customers tick a box at checkout. Needs a message template
# approved in Meta Business Manager with four body variables: name, order number, update, link. Leave empty to hide the option
# in production (development logs the message).
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE="order_update"
WHATSAPP_TEMPLATE_LANG="en"

# How many proxies or load balancers sit in front of the API (usually 1). Without it the rate limits see every visitor as the proxy.
TRUST_PROXY=""

# Operations
# LOG_FORMAT="json"        # one JSON object per log line (for Datadog, Loki, CloudWatch...); default is readable text
# ERROR_WEBHOOK_URL=""     # Slack, Discord or any webhook that takes JSON with a "text" field and should hear about unexpected API errors

# Transactional email can also go through any SMTP provider instead of Amazon SES (with MAIL_FROM set):
# SMTP_URL="smtps://username:password@smtp.example.com:465"

# Where uploaded pictures and videos are kept: "local" (the uploads folder, default) or "s3" (any S3-compatible bucket:
# AWS S3, Cloudflare R2, DigitalOcean Spaces, Backblaze B2, MinIO...). Leave the keys empty to use the host's own identity.
STORAGE_DRIVER="local"
# UPLOAD_DIR=""
# S3_BUCKET=""
# S3_REGION=""
# S3_ENDPOINT=""
# S3_FORCE_PATH_STYLE="false"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PREFIX=""
# STORAGE_PUBLIC_URL=""

# Operations: LOG_FORMAT=json prints one JSON line per log entry; ERROR_WEBHOOK_URL receives a message
# (Slack, Discord, Teams or any webhook) when the API hits an unexpected error.
LOG_FORMAT=""
ERROR_WEBHOOK_URL=""
