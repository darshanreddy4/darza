generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  // Runs orders, returns and customer questions; see auth/permissions.ts.
  STAFF
  ADMIN
}

// Who changed what in the admin area. Names are copied in so the record stays readable if the account is later removed.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actorName String
  actorRole Role
  action    String
  summary   String
  entity    String?
  entityId  String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([entity, entityId])
}

enum ProductType {
  OWN
  AFFILIATE
}

enum ProductStatus {
  DRAFT
  PUBLISHED
}

enum OrderStatus {
  PENDING_PAYMENT
  PLACED
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

model User {
  id               String            @id @default(cuid())
  // An account is reached by email, by phone number (one-time code) or by Google; any one is enough.
  email            String?           @unique
  phone            String?           @unique
  phoneVerifiedAt  DateTime?
  googleId         String?           @unique
  name             String
  // Phone and Google sign-ups get a random hash nobody knows; they can set a real password with "forgot password".
  passwordHash     String
  role             Role              @default(CUSTOMER)
  // The team role that decides what a STAFF user may do; empty means the original staff permissions.
  staffRoleId      String?
  staffRole        StaffRole?        @relation(fields: [staffRoleId], references: [id], onDelete: Restrict)
  emailVerifiedAt  DateTime?
  termsAcceptedAt  DateTime?
  // False for accounts made with a phone number or Google, whose password is a random one nobody knows.
  passwordSet      Boolean           @default(true)
  // The account was deleted by its owner: personal details are removed, order records stay for tax purposes.
  deletedAt        DateTime?
  // Wrong password tries in a row, and when sign-in with a password is allowed again after too many.
  failedLogins     Int               @default(0)
  lockedUntil      DateTime?
  // Opt-out for "you left something in your cart" emails.
  cartRemindersOff Boolean           @default(false)
  cartSnapshot     CartSnapshot?
  // Bumped on password change/reset to sign out every existing session.
  tokenVersion     Int               @default(0)
  // Made at checkout from a verified mobile number alone. Such customers pay online, or the delivery charge online and the rest on delivery, until they set a password or confirm an email.
  guestCheckout    Boolean           @default(false)
  createdAt        DateTime          @default(now())
  orders           Order[]
  wishlist         WishlistItem[]
  reviews          Review[]
  views            ProductView[]
  authTokens       AuthToken[]
  addresses        Address[]
  returns          ReturnRequest[]
  questions        ProductQuestion[]
  stockAlerts      StockAlert[]
  couponAccess     CouponCustomer[]
}

// A named set of permissions for team members, made by an admin: customer care, finance, product reviewer and so on.
model StaffRole {
  id          String   @id @default(cuid())
  name        String   @unique
  description String   @default("")
  // Keys such as "orders.view"; the list of valid keys lives in the API.
  permissions String[] @default([])
  members     User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum AuthTokenType {
  PASSWORD_RESET
  EMAIL_VERIFY
  // Confirms a new email address for an account that had none; the address is in AuthToken.data.
  EMAIL_ADD
}

// Only a SHA-256 hash of the emailed token is stored.
model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AuthTokenType
  tokenHash String        @unique
  data      String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId, type])
}

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  products  Product[]
  createdAt DateTime   @default(now())
}

// All money values are stored in paise (INR minor units).
model Product {
  id             String         @id @default(cuid())
  name           String
  slug           String         @unique
  description    String
  brand          String?
  specifications Json           @default("{}") @db.Json
  categoryId     String
  category       Category       @relation(fields: [categoryId], references: [id])
  images         ProductImage[]
  videoUrls      String[]       @default([])
  highlights     String[]       @default([])

  productType ProductType
  status      ProductStatus @default(DRAFT)
  featured    Boolean       @default(false)

  pricePaise   Int
  mrpPaise     Int?
  // Blank on our own products means "the brand name", read from the brand settings.
  sellerName   String  @default("")
  deliveryInfo String?
  returnPolicy String?

  // What the product card shows on the storefront. Defaults keep cards as they were.
  showRating       Boolean   @default(true)
  dealLabel        String?
  deliveryDays     Int?
  // Always ships free, whatever the order total.
  freeDelivery     Boolean   @default(false)
  // Heavy or bulky: always pays delivery (deliveryFeePaise, or the store's fee when empty) until the whole order passes the store's free-everything amount.
  chargeDelivery   Boolean   @default(false)
  deliveryFeePaise Int?
  showAddToCart    Boolean   @default(false)
  // e.g. "1750 ml" or "600 ml, 800 ml, 1100 ml"; shown under the name.
  packSize         String?
  // TOP_DISCOUNT or LOWEST_PRICE, chosen by the admin; shown as a tag on the card.
  saleTag          String?
  // Units bought, counted from real orders.
  showSold         Boolean   @default(true)
  // "Buy N items, save extra P%": own products only, both set or both empty.
  multiBuyQty      Int?
  multiBuyPercent  Int?
  // A timed sale on our own products: the price is salePricePaise until saleEndsAt, then it goes back to pricePaise by itself.
  salePricePaise   Int?
  saleEndsAt       DateTime?
  // Days a customer can return it after delivery: empty uses the store's window, 0 means no returns.
  returnDays       Int?
  // Products with the same variantGroup are shown as options of each other (colour and pack size).
  variantGroup     String?
  colorName        String?
  warranty         String?
  // Manufacturer, packer and country of origin, as printed on the pack.
  manufacturerInfo String?

  // Used on invoices once GST is switched on in store settings; prices already include it.
  gstRatePercent Int     @default(18)
  // HSN (goods) or SAC (services) code printed on GST invoices: 4, 6 or 8 digits.
  hsnCode        String?
  // Weight of one unit in grams, when the store records weights.
  weightGrams    Int?
  // Must be paid for online in full: a basket holding it cannot use pay on delivery.
  onlineOnly     Boolean @default(false)
  // Part payment: this share of the order is paid online first and the rest on delivery. Only used while the store has part payment switched on.
  advancePercent Int?

  // OWN only
  sku               String?   @unique
  stock             Int?
  // Set when the low-stock email went out for this dip; cleared once stock recovers.
  lowStockAlertedAt DateTime?
  costPaise         Int?

  // AFFILIATE only
  platform            String?
  affiliateUrl        String?
  affiliateDisclosure String?

  // Sizes or weights of the same product (1 kg, 25 kg), each with its own price and stock. When there are any, pricePaise is the lowest option price and stock the total.
  // What the customer chooses between, named by the admin ("Size", "Colour", "Wattage"): one or two, matching the values of each option.
  optionNames    String[]          @default([])
  options        ProductOption[]
  warehouseStock WarehouseStock[]
  clicks         AffiliateClick[]
  orderItems     OrderItem[]
  views          ProductView[]
  wishlistedBy   WishlistItem[]
  reviews        Review[]
  questions      ProductQuestion[]
  stockAlerts    StockAlert[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([status, categoryId])
  @@index([status, featured])
}

model ProductOption {
  id                String           @id @default(cuid())
  productId         String
  product           Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  label             String
  // One value per option name ("Black", "L"); label is them joined with " / ".
  values            String[]         @default([])
  // One of the product's own pictures, shown when this option is chosen.
  imageUrl          String?
  pricePaise        Int
  mrpPaise          Int?
  stock             Int              @default(0)
  costPaise         Int?
  position          Int              @default(0)
  // Each option can have its own SKU and weight (grams).
  sku               String?          @unique
  weightGrams       Int?
  // Set when the low-stock email mentioned this option; cleared once it is back above the threshold.
  lowStockAlertedAt DateTime?
  warehouseStock    WarehouseStock[]

  @@unique([productId, label])
  @@index([productId, position])
}

// Where stock is kept. The main warehouse holds whatever the other warehouses do not, so a shop with one place needs no extra rows.
model Warehouse {
  id        String           @id @default(cuid())
  name      String           @unique
  code      String           @unique
  address   String?
  isMain    Boolean          @default(false)
  active    Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  stock     WarehouseStock[]
  movements StockMovement[]
}

// Units of one item (a product, or one option of it) kept in a warehouse other than the main one.
model WarehouseStock {
  id          String         @id @default(cuid())
  warehouseId String
  warehouse   Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  productId   String
  product     Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionId    String?
  option      ProductOption? @relation(fields: [optionId], references: [id], onDelete: Cascade)
  // The option id, or "-" for a product without options; makes one row per warehouse and item.
  itemKey     String
  quantity    Int

  @@unique([warehouseId, productId, itemKey])
  @@index([productId])
}

enum StockReason {
  SALE
  CANCELLED
  RETURNED
  RECEIVED
  ADJUSTMENT
  TRANSFER
  EDIT
  IMPORT
}

// Every change to the units on hand. Names are copied so the history stays readable after a product is deleted.
model StockMovement {
  id           String      @id @default(cuid())
  createdAt    DateTime    @default(now())
  productId    String
  productName  String
  optionId     String?
  optionLabel  String?
  warehouseId  String?
  warehouse    Warehouse?  @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  delta        Int
  // Units of the item in all warehouses after this change.
  balanceAfter Int
  reason       StockReason
  note         String?
  orderId      String?
  actorId      String?
  actorName    String?

  @@index([productId, createdAt])
  @@index([warehouseId, createdAt])
  @@index([createdAt])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  position  Int     @default(0)
}

model AffiliateClick {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  platform  String?
  referrer  String?
  ipHash    String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([productId, createdAt])
}

model Order {
  id                  String          @id @default(cuid())
  userId              String
  user                User            @relation(fields: [userId], references: [id])
  status              OrderStatus     @default(PENDING_PAYMENT)
  // totalPaise is what the customer pays: subtotal - discount + shipping.
  subtotalPaise       Int             @default(0)
  discountPaise       Int             @default(0)
  // The part of discountPaise that came from a percentage reward on the progress bar rather than a coupon.
  rewardDiscountPaise Int             @default(0)
  shippingPaise       Int             @default(0)
  // The pay-on-delivery fee, which is already inside shippingPaise.
  codFeePaise         Int             @default(0)
  // Part payment: the share paid online up front; the rest (totalPaise minus this) is collected on delivery. 0 for ordinary orders.
  advancePaise        Int             @default(0)
  totalPaise          Int
  // Free gifts the order earned by passing the store's gift amounts, to pack with it.
  gifts               String[]        @default([])
  couponId            String?
  coupon              Coupon?         @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCode          String?
  // Whether the store was charging GST when the order was placed; decides tax invoice or bill of supply.
  gstApplied          Boolean         @default(false)
  invoiceNumber       String?         @unique
  invoicedAt          DateTime?
  shippedAt           DateTime?
  // Who carries the parcel and how the customer follows it; all typed by the admin or staff when the order is marked shipped.
  courierName         String?
  trackingNumber      String?
  trackingUrl         String?
  deliveredAt         DateTime?
  cancelReason        String?
  // The customer agreed to order updates on WhatsApp, sent to the phone number on this order.
  whatsappOptIn       Boolean         @default(false)
  refundId            String?
  refundedPaise       Int             @default(0)
  shippingName        String
  shippingAddr        Json
  paymentRef          String?
  paymentId           String?
  paymentMethod       String          @default("COD")
  // Who bought, as stable keys (see store/identity.ts): the account's email and phone and the phone given for delivery. They
  // stay on the order if the account is later deleted, so a coupon limited to one use per customer cannot be used again.
  buyerEmailKey       String?
  buyerPhoneKey       String?
  shipPhoneKey        String?
  items               OrderItem[]
  returns             ReturnRequest[]
  createdAt           DateTime        @default(now())

  @@index([status, createdAt])
  @@index([paymentRef])
  @@index([userId])
  @@index([couponId, status])
  @@index([buyerEmailKey])
  @@index([buyerPhoneKey])
  @@index([shipPhoneKey])
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  REFUNDED
}

// A customer's request to send some or all of a delivered order's items back; an order can have several.
model ReturnRequest {
  id         String       @id @default(cuid())
  orderId    String
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason     String
  details    String?
  status     ReturnStatus @default(REQUESTED)
  adminNote  String?
  createdAt  DateTime     @default(now())
  resolvedAt DateTime?

  items       ReturnItem[]
  // What was refunded for these items, once it has been.
  refundPaise Int?
  // Pay-on-delivery orders are refunded by hand: the customer's UPI ID, and when and how the admin paid it.
  payoutUpi   String?
  // The part of the refund that goes back by UPI instead of the online payment; empty on older requests, which pay all of it out for pay-on-delivery orders.
  payoutPaise Int?
  payoutRef   String?
  paidOutAt   DateTime?

  @@index([orderId])
  @@index([status, createdAt])
  @@index([userId])
}

// The items (and how many of each) one return request covers.
model ReturnItem {
  id          String        @id @default(cuid())
  requestId   String
  request     ReturnRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  orderItemId String
  orderItem   OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  quantity    Int

  @@index([requestId])
  @@index([orderItemId])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product @relation(fields: [productId], references: [id])
  quantity       Int
  pricePaise     Int
  costPaise      Int?
  gstRatePercent Int     @default(0)
  // The product's HSN code when it was bought, so the invoice keeps it.
  hsnCode        String?
  // The SKU and weight (grams per unit) of the item when it was bought, so packing slips keep them.
  sku            String?
  weightGrams    Int?
  // The size or weight bought, kept as text so the order still reads right if the option is later renamed or removed.
  optionId       String?
  optionLabel    String?

  // Units already returned and refunded.
  returnedQty Int          @default(0)
  returnItems ReturnItem[]
  // Days the customer had to return this item when they bought it; 0 means no returns. Empty on older orders, which use the store's window.
  returnDays  Int?

  @@index([productId])
}

model ProductView {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  visitorId String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([productId, createdAt])
  @@index([productId, visitorId, createdAt])
}

model WishlistItem {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, productId])
  @@index([productId])
}

// The last cart a signed-in customer built, kept only so a reminder can be emailed if they never check out.
model CartSnapshot {
  userId     String    @id
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // [{ productId, quantity }]; names and prices are read from the catalogue when the email is sent.
  items      Json
  savedAt    DateTime  @default(now())
  remindedAt DateTime?

  @@index([remindedAt, savedAt])
}

// A shopper asking to be emailed once a sold-out product is available again.
model StockAlert {
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  notifiedAt DateTime?

  @@id([userId, productId])
  @@index([productId, notifiedAt])
}

// A shopper's question about a product. It is shown on the product page once an admin has answered it.
model ProductQuestion {
  id         String    @id @default(cuid())
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   String
  answer     String?
  answeredAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([productId, answeredAt])
  @@index([answeredAt, createdAt])
}

model Review {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating    Int
  title     String?
  body      String
  verified  Boolean       @default(false)
  createdAt DateTime      @default(now())
  media     ReviewMedia[]

  @@unique([userId, productId])
  @@index([productId])
}

enum ReviewMediaType {
  IMAGE
  VIDEO
}

// A photo or short video a customer attached to their review.
model ReviewMedia {
  id       String          @id @default(cuid())
  reviewId String
  review   Review          @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  type     ReviewMediaType
  url      String
  position Int             @default(0)

  @@index([reviewId])
}

enum BannerTone {
  LIGHT
  DARK
}

model Banner {
  id              String     @id @default(cuid())
  title           String
  subtitle        String?
  imageUrl        String
  ctaLabel        String?
  linkUrl         String?
  textTone        BannerTone @default(LIGHT)
  position        Int        @default(0)
  active          Boolean    @default(true)
  startsAt        DateTime?
  endsAt          DateTime?
  showCountdown   Boolean    @default(false)
  videoUrl        String?
  sponsorName     String?
  textPosition    String     @default("middle-left")
  buttonPosition  String?
  impressionCount Int        @default(0)
  clickCount      Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([active, position])
}

model StoreSettings {
  id                    String    @id @default("default")
  shippingFeePaise      Int       @default(4900)
  // Null means delivery is never free; 0 fee means always free.
  freeShippingOverPaise Int?      @default(49900)
  // When the whole basket reaches this, every delivery charge (heavy items included) is waived. Null turns it off.
  freeAllOverPaise      Int?
  // [{ name, pincodes: ["79", "744101"], feePaise, freeOverPaise | null }]: areas whose PIN codes start with these digits pay their own fee.
  deliveryZones         Json      @default("[]")
  // [{ atPaise, title }]: free gifts for baskets of at least this much.
  giftTiers             Json      @default("[]")
  gstEnabled            Boolean   @default(false)
  gstin                 String?
  legalName             String?
  businessAddress       String?
  businessState         String?
  shippingGstPercent    Int       @default(18)
  invoicePrefix         String    @default("DZ")
  // Days after delivery that a customer can ask to return an order; 0 turns returns off.
  // Own products at or below this many units count as low stock.
  lowStockThreshold     Int       @default(5)
  // Show weight and per-option SKU fields on products; they are optional either way.
  skuWeightEnabled      Boolean   @default(false)
  // Also flag an option that runs low while the product as a whole still has plenty.
  optionStockAlerts     Boolean   @default(false)
  // Show customers a progress bar (placed, preparing, shipped, delivered) on each order in My orders.
  orderProgressEnabled  Boolean   @default(true)
  // Let shoppers order with just a verified mobile number, no account or password.
  guestCheckoutEnabled  Boolean   @default(false)
  // Guests may choose cash on delivery after paying the delivery charge online.
  guestCodEnabled       Boolean   @default(true)
  // Least a guest pays online on a cash-on-delivery order, even when delivery is free.
  guestMinAdvancePaise  Int       @default(5000)
  // Where low-stock emails go; blank turns them off.
  alertEmail            String?
  // OFF, WEEKLY (Monday) or MONTHLY (the 1st): emails last period's sales report to reportEmail.
  reportSchedule        String    @default("OFF")
  reportEmail           String?
  reportLastSentAt      DateTime?
  returnWindowDays      Int       @default(7)
  // Pay on delivery: whether it is offered, the extra fee for it, and the largest order it is allowed for (null: no limit).
  codEnabled            Boolean   @default(true)
  codFeePaise           Int       @default(0)
  codMaxOrderPaise      Int?
  // Whether products can be sold with part payment (an advance online, the rest on delivery).
  advanceEnabled        Boolean   @default(false)
  // Storefront look chosen by the admin: DEFAULT (the original look) or one of the named themes.
  theme                 String    @default("DEFAULT")
  // Colours and pictures the admin chose for the header, search bar, category bar and footer:
  // { header: { bg, fg, image, overlay }, search: { bg, fg, button, buttonFg }, nav: { bg, fg }, footer: { bg, fg, image, overlay } }.
  chromeStyle           Json      @default("{}")
  // Extra currencies shoppers may view prices in (prices are always charged in rupees), the one shown to new visitors,
  // and the exchange rates as { auto: { USD: <units per 1 INR> }, manual: { USD: <units per 1 INR> } }.
  currencyCodes         String[]  @default([])
  currencyDefault       String    @default("INR")
  currencyRates         Json      @default("{}")
  currencyRatesAt       DateTime?
  nextInvoiceNo         Int       @default(1)
  updatedAt             DateTime  @updatedAt
}

enum CouponType {
  PERCENT
  FLAT
}

model Coupon {
  id               String           @id @default(cuid())
  code             String           @unique
  description      String?
  type             CouponType
  // Percent (1-100) or rupees in paise for FLAT.
  value            Int
  minOrderPaise    Int              @default(0)
  maxDiscountPaise Int?
  startsAt         DateTime?
  endsAt           DateTime?
  usageLimit       Int?
  perUserLimit     Int?
  // A code for chosen customers only (none listed means everyone can use it).
  customers        CouponCustomer[]
  // Only for a customer who has not ordered yet.
  firstOrderOnly   Boolean          @default(false)
  // Listed for the customers who can use it, in the cart and on the progress bar; off keeps it a code they have to be given.
  visible          Boolean          @default(true)
  active           Boolean          @default(true)
  orders           Order[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model CouponCustomer {
  couponId String
  coupon   Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([couponId, userId])
  @@index([userId])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String?
  name      String
  phone     String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

// One block of the home page, in display order. With no rows the built-in default layout is shown.
model HomeWidget {
  id        String   @id
  type      String
  position  Int
  active    Boolean  @default(true)
  config    Json
  updatedAt DateTime @updatedAt

  @@index([position])
}

// Brand, about-us, contact and social details shown across the storefront. One row.
model SiteProfile {
  id               String   @id @default("default")
  brandName        String   @default("")
  // Public address of the website, used for links in emails, canonical URLs and the sitemap.
  siteUrl          String   @default("")
  logoUrl          String   @default("")
  logoOnBadge      Boolean  @default(false)
  // How the logo is drawn: picture with an effect, or a styled text wordmark. See site/logo-design.ts.
  logoDesign       Json     @default("{}")
  tagline          String   @default("")
  // Legal details shown on the Contact & Grievance page; they win over the NEXT_PUBLIC_* values in the web .env.
  legalName        String   @default("")
  gstin            String   @default("")
  grievanceOfficer String   @default("")
  grievanceEmail   String   @default("")
  // The message in the bar above the header and the Transparency box in the footer. Empty text means the standard wording.
  announcement     String   @default("")
  announcementOn   Boolean  @default(true)
  transparencyNote String   @default("")
  transparencyOn   Boolean  @default(true)
  about            String   @default("")
  email            String   @default("")
  phone            String   @default("")
  address          String   @default("")
  careHours        String   @default("")
  careNote         String   @default("")
  whatsapp         String   @default("")
  whatsappMessage  String   @default("")
  whatsappButton   Boolean  @default(false)
  socials          Json     @default("{}")
  otherLinks       Json     @default("[]")
  updatedAt        DateTime @updatedAt
}

// A policy or information page the admin controls. A row for a built-in page (terms, privacy, ...) overrides the standard text
// or hides the page; a custom row is a page of its own, shown at /pages/<slug>.
model PolicyPage {
  slug      String   @id
  title     String   @default("")
  body      String   @default("")
  enabled   Boolean  @default(true)
  custom    Boolean  @default(false)
  position  Int      @default(0)
  updatedAt DateTime @updatedAt
}

// A one-time code sent by SMS. Only a hash of the code is kept.
model OtpCode {
  id         String    @id @default(cuid())
  phone      String
  purpose    String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}
